From cd639ffe859a24ff2fc231b6de1266b90f805b19 Mon Sep 17 00:00:00 2001
From: Chris Anderson <chris@raitechnology.com>
Date: Sun, 15 Nov 2026 04:44:25 -0800
Subject: [PATCH] freedreno/kgsl: finish a shared buffer's rendering before it
 is presented

kgsl never adds a fence to a dma-buf's reservation object, so a buffer
handed to the window system carries nothing to wait on. An X server that
copies a DRI3 pixmap for PresentPixmap (or CopyArea, for front-buffer
rendering and CopySubBuffer) reads it at once and gets a frame the GPU is
still drawing: tearing, counted at 206 torn frames of 300 on an Adreno 830
with a server that copies on the CPU.

pipe_context::flush_resource is the point where a frontend says a resource
is about to be used by an external client. On msm that flushes the
rendering so the kernel attaches the fence; on kgsl there is no such fence,
so flush and wait for the rendering there. Every path that hands a buffer
over goes through it: SwapBuffers on X11 and Wayland, the DRI3 linear blit,
front-buffer flushes and CopySubBuffer.

The cost is that SwapBuffers returns after the GPU has finished the frame
instead of after it was queued. FD_KGSL_PRESENT_WAIT=0 turns the wait off.
---
 src/gallium/drivers/freedreno/freedreno_resource.c | 13 +++++++++++++
 src/gallium/drivers/freedreno/freedreno_screen.c   |  6 ++++++
 src/gallium/drivers/freedreno/freedreno_screen.h   |  1 +
 3 files changed, 20 insertions(+)

diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index bcb6c2c..bb91dfe 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -680,6 +680,19 @@ fd_flush_resource(struct pipe_context *pctx, struct pipe_resource *prsc)
    struct fd_context *ctx = fd_context(pctx);
    struct fd_resource *rsc = fd_resource(prsc);
 
+   /* kgsl never puts a fence on a dma-buf, so there is no implicit-sync
+    * for whoever is handed this buffer next to rely on: an X server asked
+    * to present or copy the pixmap, or a compositor, reads it at once,
+    * while the GPU may still be drawing it, and shows a torn frame.  The
+    * only place the rendering can be waited for is here, so finish it
+    * before the frontend tells the window system about the buffer.
+    */
+   if (ctx->screen->kgsl_present_wait && rsc->b.is_shared) {
+      flush_resource(ctx, rsc, PIPE_MAP_READ);
+      fd_resource_wait(ctx, rsc, FD_BO_PREP_READ);
+      return;
+   }
+
    /* Flushing the resource is only required if we are relying on
     * implicit-sync, in which case the rendering must be flushed
     * to the kernel for the fence to be added to the backing GEM
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
index 1275dfb..6bdb2cd 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -1007,6 +1007,12 @@ fd_screen_create(int fd,
    screen->dev = dev;
    screen->is_kgsl = fd_get_features(dev) & FD_FEATURE_KGSL;
    screen->kgsl_dmabuf = screen->is_kgsl && fd_kgsl_dmabuf_enabled();
+   /* Finish the rendering of a shared buffer before it is handed to the
+    * window system (see fd_flush_resource).  FD_KGSL_PRESENT_WAIT=0 turns
+    * it off, to measure what the wait costs or what it hides.
+    */
+   screen->kgsl_present_wait = screen->is_kgsl &&
+      debug_get_bool_option("FD_KGSL_PRESENT_WAIT", true);
    screen->ro = ro;
 
    // maybe this should be in context?
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.h b/src/gallium/drivers/freedreno/freedreno_screen.h
index d3276c8..f98f535 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.h
+++ b/src/gallium/drivers/freedreno/freedreno_screen.h
@@ -77,6 +77,7 @@ struct fd_screen {
    bool has_syncobj;
    bool is_kgsl;
    bool kgsl_dmabuf;
+   bool kgsl_present_wait;
 
    struct {
       /* Conservative LRZ (default true) invalidates LRZ on draws with
